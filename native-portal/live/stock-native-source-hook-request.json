  "aggregate_held_decision": "0x15fbb8",
  "completion": "Save StockSourceCollector::Invocation call=collector.invocation() immediately after successful begin. camera_return(pc,Saved) captures pre-RET candidate only. Call complete_own_bypass(call, actual) ONLY after this exact native-method ft_native_portal_call_saved returns. Invocation matches runtime/version/stream/sequence/ticket/method/SP/LR and actual result. Never use outer-handler result. No new RET-retirement hook required.",
  "routing": "camera_fact handles field-only callbacks; boundary_event handles manager/guard-only callbacks. event handles existing engine callbacks and selected-ID facts. Never send unsupported PC to binding engine.",
  "coverage_gate": "All existing_engine_callbacks, new_callbacks, method_entries and aggregate_held_decision must be authenticated in actual installed inventory; missing coverage means unavailable. Null kind_candidate is deliberately unresolved, not invented emitter support.",
  "no_lock_mode": "Unavailable: no executed single-thread branch witness in delivered table. Locked direct-manager path only.",
  "optional_not_required": [
    "constructor facts",
    "vptr register replacement",
    "header native load replacement",
    "ref register replacement including retry327624",
    "accessor RET2584f8"
  ],
  "callback_api": {
    "backend": "StockSourceReadBoundary { Read read=nullptr; void* context; Covered covered; ProviderLive provider_live; }",
    "Read": "bool(void*, const StockSourceReadScope&, uint64_t address, void* out, size_t bytes) noexcept. Bounded backend called only after concrete allowlist. nullptr selects process_vm_readv.",
    "Covered": "bool(void*, ClientSourceBinding::Module, uint64_t relative_pc) noexcept. Must consult actual installed/pinned inventory, not stale full-mask macro. Every required callback must be covered.",
    "ProviderLive": "bool(void*, const StockSourceReadScope&, uint64_t provider) noexcept. Identity-only proof of same-original provider lifetime and loader-pinned immutable vtable. A camera gate ticket alone is not proof; no camera tuple reads.",
    "begin": "bool begin(ticket, binding, version, method, entrySaved, compositorBase, clientBase, compDigest, clientDigest)",
    "field": "bool camera_fact(Module, pc, Saved)",
    "guard": "bool boundary_event(Module, pc, Saved)",
    "engine": "bool event(Module, pc, Saved), internally uses named NativeSelectedId instead of camera ID reread",
    "candidate": "bool camera_return(pc, Saved)",
    "complete": "bool complete_own_bypass(const Invocation&, uint64_t actual)",
    "held": "bool held_disconnect(0x15fbb8, Saved) only after actual aggregate decision selects no-op",
    "owner": "fold_stock_history(transport) only after all stock originals excluded, with explicit StockOwner at render handoff",
    "retained_caller": "Parent RetainedCaller::observe_scope(const Observer&) const; Observer=std::function<void(CameraAccessGate&,uint64_t,const CameraBinding&)>; handle remains live and unmoved/unreleased throughout complete native method."
